<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>SurgicalHub — Absence</title>
<!--[if mso]>
<style>table{border-collapse:collapse;} div,td{font-family:Arial,sans-serif;}</style>
<noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
<![endif]-->
<style>
  @media (max-width:620px){
    .sh-container{width:100% !important;}
    .sh-pad{padding-left:20px !important;padding-right:20px !important;}
  }
</style>
</head>
{% set impactedCount = impacted|length %}
{% set recoveredCount = recovered|length %}

{% macro occurrenceCard(o, badgeLabel, badgeBg, badgeColor) %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #E7EBEF;border-left:4px solid #B5761A;border-radius:10px;margin-bottom:10px;">
<tr><td style="padding:16px 18px;">
<div style="font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:700;color:#16202B;">{{ o.occurrenceDate }} · {{ o.startTime }}–{{ o.endTime }}</div>
<div style="margin-top:8px;">
{% if o.siteName %}
<span style="display:inline-block;background-color:#F1F4F7;color:#566270;font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;font-weight:600;padding:4px 10px;border-radius:100px;">{{ o.siteName }}</span>
{% endif %}
<span style="display:inline-block;background-color:{{ badgeBg }};color:{{ badgeColor }};font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;font-weight:600;padding:4px 10px;border-radius:100px;margin-left:6px;">{{ badgeLabel }}</span>
</div>
</td></tr>
</table>
{% endmacro %}
{% import _self as m %}

<body style="margin:0;padding:0;background-color:#F5F7FA;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#F5F7FA;">{{ recipientName }}, mise à jour de la disponibilité de {{ instrumentistName }} sur votre planning à venir.</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#F5F7FA;">
<tr><td align="center" style="padding:40px 16px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" class="sh-container" style="width:600px;max-width:600px;background-color:#FFFFFF;border-radius:12px;border:1px solid #E7EBEF;">

<!-- Header -->
<tr><td class="sh-pad" style="padding:26px 32px;border-bottom:1px solid #E7EBEF;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
<td style="font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:18px;font-weight:800;color:#144D38;letter-spacing:-0.2px;">
<span style="display:inline-block;width:9px;height:9px;border-radius:3px;background-color:#42A882;margin-right:9px;"></span><span>SurgicalHub</span>
</td>
<td align="right" style="font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:0.6px;text-transform:uppercase;color:#727E8C;">Planning</td>
</tr></table>
</td></tr>

<!-- Title -->
<tr><td class="sh-pad" style="padding:28px 32px 20px 32px;">
<div style="font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:23px;font-weight:800;color:#16202B;line-height:1.3;">Disponibilité de votre instrumentiste habituel</div>
</td></tr>

<!-- Greeting -->
<tr><td class="sh-pad" style="padding:0 32px 22px 32px;font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.65;color:#3A4754;">
Bonjour {{ recipientName }},<br><br>
{{ instrumentistName }} a déclaré une absence du {{ dateStart }} au {{ dateEnd }}, qui concerne des dates où {{ instrumentistName }} est habituellement prévu(e) sur votre planning. Le planning de cette période n'a pas encore été généré — aucune mission n'a été annulée. SurgicalHub tiendra compte de cette indisponibilité lors de la génération et cherchera une couverture adaptée.
</td></tr>

{% if impactedCount > 0 %}
<tr><td class="sh-pad" style="padding:0 32px 4px 32px;">
<div style="font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;color:#8A6420;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:10px;">{{ impactedCount > 1 ? 'Postes concernés' : 'Poste concerné' }}</div>
{% for occurrence in impacted %}
  {{ m.occurrenceCard(occurrence, 'Instrumentiste absent(e)', '#FBF6E9', '#8A6420') }}
{% endfor %}
</td></tr>
{% endif %}

{% if recoveredCount > 0 %}
<tr><td class="sh-pad" style="padding:12px 32px 4px 32px;">
<div style="font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;color:#1E7A54;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:10px;">{{ recoveredCount > 1 ? 'Postes de nouveau couverts' : 'Poste de nouveau couvert' }}</div>
{% for occurrence in recovered %}
  {{ m.occurrenceCard(occurrence, 'Disponibilité rétablie', '#E9F6EF', '#1E7A54') }}
{% endfor %}
</td></tr>
{% endif %}

<!-- Footer -->
<tr><td class="sh-pad" style="padding:28px 32px 30px 32px;">
<div style="border-top:1px solid #E7EBEF;padding-top:20px;font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;color:#98A2AE;line-height:1.7;">
SurgicalHub — document confidentiel, destiné uniquement à {{ recipientName }}.<br>
Cet e-mail est généré automatiquement, merci de ne pas y répondre.
</div>
</td></tr>

</table>
</td></tr>
</table>
</body>
</html>
