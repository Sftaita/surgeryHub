<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>SurgicalHub — Planning</title>
<!--[if mso]>
<style>table{border-collapse:collapse;} div,td{font-family:Arial,sans-serif;}</style>
<noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
<![endif]-->
<style>
  @media (max-width:620px){
    .sh-container{width:100% !important;}
    .sh-pad{padding-left:20px !important;padding-right:20px !important;}
  }
</style>
</head>

{% macro card(color, title, subtitle, badge) %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #E7EBEF;border-left:4px solid {{ color }};border-radius:10px;margin-bottom:10px;">
<tr><td style="padding:14px 18px;">
<div style="font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;font-weight:700;color:#16202B;">{{ title }}</div>
{% if subtitle %}<div style="font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12.5px;color:#727E8C;margin-top:3px;">{{ subtitle }}</div>{% endif %}
{% if badge %}<div style="margin-top:8px;"><span style="display:inline-block;background-color:#F1F4F7;color:#566270;font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:600;padding:3px 9px;border-radius:100px;">{{ badge }}</span></div>{% endif %}
</td></tr>
</table>
{% endmacro %}
{% import _self as m %}

{% set actionRequiredColor = '#DBAB4E' %}
{% set automaticColor = '#42A882' %}

{% set title = action == 'CREATED' ? (absentUserRole == 'SURGEON' ? 'Absence chirurgien enregistrée' : 'Absence instrumentiste enregistrée')
  : (action == 'UPDATED' ? 'Absence modifiée' : 'Absence supprimée') %}

<body style="margin:0;padding:0;background-color:#F5F7FA;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#F5F7FA;">{{ absentUserName }} · {{ dateStart }} → {{ dateEnd }}{{ actionRequiredCount > 0 ? ' · action requise' : '' }}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#F5F7FA;">
<tr><td align="center" style="padding:40px 16px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" class="sh-container" style="width:600px;max-width:600px;background-color:#FFFFFF;border-radius:12px;border:1px solid #E7EBEF;">

<!-- Header -->
<tr><td class="sh-pad" style="padding:26px 32px;border-bottom:1px solid #E7EBEF;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
<td style="font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:18px;font-weight:800;color:#144D38;letter-spacing:-0.2px;">
<span style="display:inline-block;width:9px;height:9px;border-radius:3px;background-color:#42A882;margin-right:9px;"></span><span>SurgicalHub</span>
</td>
<td align="right" style="font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:0.6px;text-transform:uppercase;color:#727E8C;">Planning</td>
</tr></table>
</td></tr>

<!-- Title -->
<tr><td class="sh-pad" style="padding:28px 32px 20px 32px;">
<div style="font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:23px;font-weight:800;color:#16202B;line-height:1.3;">{{ title }}</div>
<div style="font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:#3A4754;margin-top:6px;">{{ absentUserName }} · {{ dateStart }} → {{ dateEnd }}</div>
</td></tr>

{% if actionRequiredCount > 0 %}
<!-- Action requise -->
<tr><td class="sh-pad" style="padding:0 32px 4px 32px;">
<div style="font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;color:#B5761A;margin-bottom:8px;">Action requise</div>
{% for mission in missionsReleased %}
  {{ m.card(actionRequiredColor, mission.date ~ (mission.horaire ? ' · ' ~ mission.horaire : '') ~ (mission.siteName ? ' · ' ~ mission.siteName : ''), (mission.surgeonName ? mission.surgeonName : '') ~ ' — mission non couverte', 'À réaffecter') }}
{% endfor %}
{% for mission in missionsRestoredOpen %}
  {{ m.card(actionRequiredColor, mission.date ~ (mission.siteName ? ' · ' ~ mission.siteName : ''), (mission.surgeonName ? mission.surgeonName : '') ~ ' — restaurée mais toujours non couverte', 'À réaffecter') }}
{% endfor %}
</td></tr>
{% endif %}

{% if automaticCount > 0 %}
<!-- Impact automatique -->
<tr><td class="sh-pad" style="padding:{{ actionRequiredCount > 0 ? '16px' : '0' }} 32px 4px 32px;">
<div style="font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;color:#727E8C;margin-bottom:8px;">Impact automatique</div>
{% for mission in missionsCancelled %}
  {{ m.card(automaticColor, mission.date ~ (mission.horaire ? ' · ' ~ mission.horaire : '') ~ (mission.siteName ? ' · ' ~ mission.siteName : ''), (mission.instrumentistName ? mission.instrumentistName : ''), 'Annulée') }}
{% endfor %}
{% for occurrence in futureOccurrencesCancelled %}
  {{ m.card(automaticColor, occurrence.occurrenceDate ~ (occurrence.startTime ? ' · ' ~ occurrence.startTime ~ '–' ~ occurrence.endTime : '') ~ (occurrence.siteName ? ' · ' ~ occurrence.siteName : ''), (occurrence.instrumentistName ? occurrence.instrumentistName : 'Aucun instrumentiste habituel'), 'Poste futur neutralisé') }}
{% endfor %}
{% for mission in missionsRestoredAssigned %}
  {{ m.card(automaticColor, mission.date ~ (mission.siteName ? ' · ' ~ mission.siteName : ''), (mission.instrumentistName ? mission.instrumentistName : ''), 'Réaffectée') }}
{% endfor %}
{% for occurrence in futureOccurrencesRestored %}
  {{ m.card(automaticColor, occurrence.occurrenceDate ~ (occurrence.startTime ? ' · ' ~ occurrence.startTime ~ '–' ~ occurrence.endTime : '') ~ (occurrence.siteName ? ' · ' ~ occurrence.siteName : ''), (occurrence.instrumentistName ? occurrence.instrumentistName : 'Aucun instrumentiste habituel'), 'Poste futur réactivé') }}
{% endfor %}
</td></tr>
{% endif %}

{% if actionRequiredCount == 0 %}
<tr><td class="sh-pad" style="padding:4px 32px 0 32px;font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;color:#3A4754;">
Aucune action supplémentaire n'est requise.
</td></tr>
{% endif %}

<!-- Footer -->
<tr><td class="sh-pad" style="padding:28px 32px 30px 32px;">
<div style="border-top:1px solid #E7EBEF;padding-top:20px;font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;color:#98A2AE;line-height:1.7;">
SurgicalHub — document confidentiel, destiné uniquement à {{ recipientName }}.<br>
Cet e-mail est généré automatiquement, merci de ne pas y répondre.
</div>
</td></tr>

</table>
</td></tr>
</table>
</body>
</html>
