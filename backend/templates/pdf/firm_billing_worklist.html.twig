<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: DejaVu Sans, sans-serif; font-size: 9px; color: #1a1a1a; }
  .page { padding: 24px 28px; }
  .header { display: table; width: 100%; margin-bottom: 14px; border-bottom: 2px solid #1565C0; padding-bottom: 10px; }
  .header-left { display: table-cell; vertical-align: top; }
  .header-right { display: table-cell; text-align: right; vertical-align: top; color: #666; }
  .logo { font-size: 16px; font-weight: bold; color: #1565C0; letter-spacing: 1px; }
  .title { font-size: 13px; font-weight: bold; margin-top: 2px; }
  .meta { margin-bottom: 12px; }
  .meta span { display: inline-block; margin-right: 24px; }
  .meta b { color: #555; font-weight: bold; }
  table { width: 100%; border-collapse: collapse; }
  thead th { background: #1565C0; color: #fff; padding: 5px 5px; text-align: left; font-size: 8px; font-weight: bold; }
  thead th.right, td.right { text-align: right; }
  tbody tr:nth-child(even) { background: #f6f8fc; }
  tbody td { padding: 4px 5px; border-bottom: 1px solid #e6e9f0; vertical-align: top; }
  .ref { color: #666; }
  .badge { display: inline-block; padding: 1px 5px; border-radius: 6px; font-size: 7.5px; font-weight: bold; }
  .s-BILLABLE { background: #e8f5e9; color: #2e7d32; }
  .s-NOT_BILLABLE { background: #eceff1; color: #455a64; }
  .s-TO_REVIEW { background: #fff3e0; color: #e65100; }
  .s-INVOICED { background: #e3f2fd; color: #1565C0; }
  .total { margin-top: 12px; text-align: right; }
  .total-box { display: inline-block; background: #1565C0; color: #fff; padding: 7px 14px; border-radius: 4px; }
  .total-label { font-size: 8px; text-transform: uppercase; letter-spacing: 0.5px; }
  .total-amount { font-size: 13px; font-weight: bold; }
  .footer { margin-top: 18px; font-size: 7.5px; color: #999; text-align: center; }
</style>
</head>
<body>
<div class="page">
  <div class="header">
    <div class="header-left">
      <div class="logo">SURGICALHUB</div>
      <div class="title">Facturation firmes — prestations sélectionnées</div>
    </div>
    <div class="header-right">Généré le {{ generatedAt }}</div>
  </div>

  <div class="meta">
    <span><b>Période :</b> {{ period }}</span>
    <span><b>Firmes :</b> {{ firms }}</span>
    <span><b>Lignes :</b> {{ lines|length }}</span>
  </div>

  <table>
    <thead>
      <tr>
        <th>Date</th>
        <th>Site</th>
        <th>Chirurgien</th>
        <th>Type</th>
        <th>Prestation</th>
        <th>Firme</th>
        <th class="right">Qté</th>
        <th>Facturation</th>
        <th>Motif</th>
        <th class="right">Montant</th>
        <th>Facture</th>
      </tr>
    </thead>
    <tbody>
      {% for l in lines %}
      <tr>
        <td>{{ l.date }}</td>
        <td>{{ l.site }}</td>
        <td>{{ l.surgeon }}</td>
        <td>{{ l.type }}</td>
        <td>{{ l.label }}{% if l.reference %}<br><span class="ref">Réf. {{ l.reference }}</span>{% endif %}</td>
        <td>{{ l.firm }}</td>
        <td class="right">{{ l.quantity }}</td>
        <td><span class="badge s-{{ l.status }}">{{ l.statusLabel }}</span></td>
        <td>{{ l.reason }}</td>
        <td class="right">{{ l.amount }}</td>
        <td>{{ l.invoice }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="total">
    <div class="total-box">
      <div class="total-label">Total facturable</div>
      <div class="total-amount">{{ totals|join(' + ') }}</div>
    </div>
  </div>

  <div class="footer">Document de travail interne — ne constitue pas une facture. Seules les lignes « Facturable » sont additionnées.</div>
</div>
</body>
</html>
